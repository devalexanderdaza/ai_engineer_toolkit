{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Engineer Toolkit Capability Profile",
  "type": "object",
  "required": ["profile_id", "version", "primary_host", "tiers"],
  "properties": {
    "profile_id": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "primary_host": { "type": "string" },
    "secondary_hosts": { "type": "array", "items": { "type": "string" } },
    "budget_policy": { "type": "object" },
    "providers": { "type": "object" },
    "tiers": {
      "type": "object",
      "properties": {
        "fast": { "$ref": "#/definitions/tier" },
        "medium": { "$ref": "#/definitions/tier" },
        "heavy": { "$ref": "#/definitions/tier" }
      }
    },
    "modes": { "type": "object" },
    "discovery": { "type": "object" },
    "fallback": { "type": "object" },
    "router_config": { "type": "object" }
  },
  "definitions": {
    "tier": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "model"],
            "properties": {
              "provider": { "type": "string" },
              "model": { "type": "string" },
              "priority": { "type": "integer" }
            }
          }
        },
        "selection": { "type": "string" },
        "requires": { "type": "string" }
      }
    }
  }
}
